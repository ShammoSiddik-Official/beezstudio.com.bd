# Place this whole php-api/ folder's contents at public_html/api/ on cPanel.
# Maps the clean URLs the frontend already calls to the PHP files.

RewriteEngine On

RewriteRule ^contact$ contact.php [L,QSA]
RewriteRule ^chat$ chat.php [L,QSA]

RewriteRule ^admin/auth/setup-status$ admin/auth.php?action=setup-status [L,QSA]
RewriteRule ^admin/auth/setup$ admin/auth.php?action=setup [L,QSA]
RewriteRule ^admin/auth/login$ admin/auth.php?action=login [L,QSA]
RewriteRule ^admin/auth/me$ admin/auth.php?action=me [L,QSA]

RewriteRule ^admin/stats$ admin/stats.php [L,QSA]

RewriteRule ^admin/contacts/([0-9]+)$ admin/contacts.php?id=$1 [L,QSA]
RewriteRule ^admin/contacts$ admin/contacts.php [L,QSA]

RewriteRule ^admin/projects/([0-9]+)$ admin/projects.php?id=$1 [L,QSA]
RewriteRule ^admin/projects$ admin/projects.php [L,QSA]

RewriteRule ^admin/users/([0-9]+)$ admin/users.php?id=$1 [L,QSA]
RewriteRule ^admin/users$ admin/users.php [L,QSA]

# Never serve config files or the schema directly, even by accident.
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql)$">
    Require all denied
</FilesMatch>
