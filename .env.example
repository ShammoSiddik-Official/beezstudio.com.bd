# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`. Never commit the real .env file.

# Postgres password used by both the postgres and api-server services.
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Used to sign admin JWTs AND as the one-time bootstrap token for creating
# the first admin account at https://yourdomain.com/admin/ (Setup screen).
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Gemini API key for the site's AI chatbot (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
